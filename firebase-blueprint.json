{
  "entities": {
    "ProjetoDeLei": {
      "title": "Projeto de Lei",
      "description": "Projeto de lei acompanhado pela área de Gestão do Conhecimento.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projeto": { "type": "string", "description": "Número do projeto acompanhado" },
        "ementa": { "type": "string", "description": "Resumo do tema do projeto" },
        "situacao": { "type": "string", "description": "Estado atual do projeto na Câmara ou Senado" },
        "ultimoAndamento": { "type": "string", "description": "Descrição do último movimento relevante" },
        "comissao": { "type": "string", "description": "Comissão onde o projeto está tramitando" },
        "local": { "type": "string", "description": "Senado ou Câmara" },
        "unAn": { "type": "string", "description": "Unidade de negócio impactada (separada por ;)" },
        "tema": { "type": "string", "description": "Tema do projeto (separado por ;)" },
        "lei": { "type": "string", "description": "Leis que serão alteradas (separada por ;)" },
        "link": { "type": "string", "description": "Link da página do projeto" },
        "pareceres": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "titulo": { "type": "string" },
              "link": { "type": "string" }
            },
            "required": ["titulo", "link"]
          },
          "description": "Lista de pareceres aprovados (máximo 10)"
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projeto", "ementa", "situacao", "link"]
    },
    "User": {
      "title": "User",
      "description": "User of the application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Source": {
      "title": "Fonte de Informação",
      "description": "Fonte de informação usada para clippings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "link": { "type": "string" },
        "tema": { "type": "string" },
        "statusInoreader": { "type": "string", "enum": ["Leitor de RSS", "Acesso Direto"] },
        "sigla": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "link", "tema", "statusInoreader"]
    },
    "TemaRepetitivo": {
      "title": "Tema Repetitivo",
      "description": "Tema repetitivo do STJ.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "Tema": { "type": "string" },
        "Situação do Tema": { "type": "string" },
        "Órgão Julgador": { "type": "string" },
        "Ramo do Direito": { "type": "string" },
        "Questão Submetida a Julgamento": { "type": "string" },
        "Tese Firmada": { "type": "string" },
        "Anotações Nugepnac": { "type": "string" },
        "Informações Complementares": { "type": "string" },
        "Repercussão Geral": { "type": "string" },
        "processos": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ControversiaSTJ": {
      "title": "Controvérsia do STJ",
      "description": "Controvérsia do STJ.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "Controvérsia": { "type": "string" },
        "Situação da Controvérsia": { "type": "string" },
        "Órgão Julgador": { "type": "string" },
        "Ramo do Direito": { "type": "string" },
        "Descrição": { "type": "string" },
        "Anotações Nugepnac": { "type": "string" },
        "Informações Complementares": { "type": "string" },
        "Repercussão Geral": { "type": "string" },
        "processos": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "RepercussaoGeralSTF": {
      "title": "Repercussão Geral STF",
      "description": "Repercussão Geral STF.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "Número Tema": { "type": "string" },
        "Título tema": { "type": "string" },
        "Tese": { "type": "string" },
        "Descrição tema": { "type": "string" },
        "Situação repercussão geral": { "type": "string" },
        "Processo paradigma": { "type": "string" },
        "Relator atual": { "type": "string" },
        "Situação Processo Paradigma": { "type": "string" },
        "Situação admissibilidade tema": { "type": "string" },
        "Situação julgamento tema": { "type": "string" },
        "Data autuação": { "type": "string" },
        "Data admissibilidade RG": { "type": "string" },
        "Data julgamento tema": { "type": "string" },
        "processos": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "NewsItem": {
      "title": "Notícia de Empresa",
      "description": "Item de notícia capturado via feed RSS para monitoramento de empresas.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "link": { "type": "string" },
        "pubDate": { "type": "string" },
        "content": { "type": "string" },
        "company": { "type": "string" },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "link", "company", "timestamp"]
    },
    "Clipping": {
      "title": "Clipping UN Corporate",
      "description": "Edições do Clipping UN Corporate e seus conteúdos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "period": { "type": "string" },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "InovacaoProjeto": {
      "title": "Projeto de Inovação",
      "description": "Iniciativa do Painel de Inovação com métricas de gestão.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projeto": { "type": "string" },
        "tipo_iniciativa": { "type": "string" },
        "categoria": { "type": "string" },
        "ferramenta_fornecedor": { "type": "string" },
        "dor_resolvida": { "type": "string" },
        "un_area": { "type": "string" },
        "socio_sponsor": { "type": "string" },
        "responsavel_gc": { "type": "string" },
        "pilar_pe": { "type": "string" },
        "prioridade": { "type": "string" },
        "alcada": { "type": "string" },
        "decisao_comite": { "type": "string" },
        "etapa_atual": { "type": "string" },
        "situacao": { "type": "string" },
        "saude_projeto": { "type": "string" },
        "bloqueado": { "type": "string" },
        "risco_principal": { "type": "string" },
        "nivel_risco": { "type": "string" },
        "data_pedido": { "type": "string" },
        "golive_previsto_linha_base": { "type": "string" },
        "golive_previsto_atual": { "type": "string" },
        "golive_realizado": { "type": "string" },
        "orcamento_previsto": { "type": "number" },
        "custo_realizado": { "type": "number" },
        "modelo_custo": { "type": "string" },
        "licencas_contratadas": { "type": "number" },
        "proximo_passo": { "type": "string" },
        "ultima_atualizacao": { "type": "string" }
      },
      "required": ["projeto"]
    },
    "InovacaoEtapas": {
      "title": "Etapas do Projeto de Inovação",
      "description": "Registro das datas de início e fim das 9 etapas do projeto.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mapeamento_ferramentas_inicio": { "type": "string" },
        "mapeamento_ferramentas_fim": { "type": "string" },
        "testes_inicio": { "type": "string" },
        "testes_fim": { "type": "string" },
        "negociacao_contrato_inicio": { "type": "string" },
        "negociacao_contrato_fim": { "type": "string" },
        "assinatura_contrato_inicio": { "type": "string" },
        "assinatura_contrato_fim": { "type": "string" },
        "inicio_projeto_inicio": { "type": "string" },
        "inicio_projeto_fim": { "type": "string" },
        "projeto_andamento_inicio": { "type": "string" },
        "projeto_andamento_fim": { "type": "string" },
        "golive_inicio": { "type": "string" },
        "golive_fim": { "type": "string" },
        "treinamentos_inicio": { "type": "string" },
        "treinamentos_fim": { "type": "string" },
        "feedbacks_inicio": { "type": "string" },
        "feedbacks_fim": { "type": "string" }
      }
    },
    "InovacaoAdocao": {
      "title": "Adoção e Treinamento de Inovação",
      "description": "Métricas de adoção por projeto, mês e UN.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projeto_id": { "type": "string" },
        "mes_referencia": { "type": "string" },
        "un_area": { "type": "string" },
        "licencas_disponiveis": { "type": "number" },
        "usuarios_ativos_mes": { "type": "number" },
        "sessoes_treinamento_mes": { "type": "number" },
        "pessoas_treinadas": { "type": "number" },
        "publico_alvo_treinamento": { "type": "number" },
        "observacoes": { "type": "string" }
      }
    },
    "InovacaoValorQualidade": {
      "title": "Valor e Qualidade de Inovação",
      "description": "Impacto de tempo e qualidade por projeto e bimestre.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projeto_id": { "type": "string" },
        "bimestre": { "type": "string" },
        "pessoas_impactadas": { "type": "number" },
        "horas_economizadas_bimestre": { "type": "number" },
        "metodo_apuracao": { "type": "string" },
        "tempo_medio_antes": { "type": "number" },
        "tempo_medio_depois": { "type": "number" },
        "nota_qualidade_antes": { "type": "number" },
        "nota_qualidade_depois": { "type": "number" },
        "satisfacao_usuarios": { "type": "number" },
        "respostas_feedback": { "type": "number" },
        "comentarios": { "type": "string" }
      }
    },
    "InovacaoMetaPE": {
      "title": "Metas do Planejamento Estratégico",
      "description": "Indicadores M1 a M9 e metas de Inovação.",
      "type": "object",
      "properties": {
        "codigo": { "type": "string" },
        "pilar": { "type": "string" },
        "indicador": { "type": "string" },
        "o_que_mede": { "type": "string" },
        "tipo_meta": { "type": "string" },
        "meta": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/clippings/{clippingId}": {
      "schema": "Clipping",
      "description": "Edições do Clipping UN Corporate."
    },
    "/painel_inovacao_projetos/{projetoId}": {
      "schema": "InovacaoProjeto",
      "description": "Projetos e iniciativas do Painel de Inovação."
    },
    "/painel_inovacao_etapas/{projetoId}": {
      "schema": "InovacaoEtapas",
      "description": "Datas e status das 9 etapas por projeto de inovação."
    },
    "/painel_inovacao_adocao/{adocaoId}": {
      "schema": "InovacaoAdocao",
      "description": "Métricas de adoção e treinamentos por projeto, mês e UN."
    },
    "/painel_inovacao_valor_qualidade/{registroId}": {
      "schema": "InovacaoValorQualidade",
      "description": "Métricas de horas economizadas, tempo e qualidade por projeto e bimestre."
    },
    "/painel_inovacao_metas_pe/{metaId}": {
      "schema": "InovacaoMetaPE",
      "description": "Metas estratégicas M1 a M9 e configuração do ano de apuração."
    },
    "/projetosDeLei/{projetoId}": {
      "schema": "ProjetoDeLei",
      "description": "Coleção de projetos de lei monitorados."
    },
    "/fontesDeInformacao/{sourceId}": {
      "schema": "Source",
      "description": "Coleção de fontes de informação."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção de usuários e seus papéis."
    },
    "/temasRepetitivos/{temaId}": {
      "schema": "TemaRepetitivo",
      "description": "Coleção de temas repetitivos do STJ."
    },
    "/controversiasSTJ/{controversiaId}": {
      "schema": "ControversiaSTJ",
      "description": "Coleção de controvérsias do STJ."
    },
    "/repercussaoGeralSTF/{temaId}": {
      "schema": "RepercussaoGeralSTF",
      "description": "Coleção de repercussão geral do STF."
    },
    "/news_items/{itemId}": {
      "schema": "NewsItem",
      "description": "Histórico de notícias capturadas para monitoramento de empresas."
    }
  }
}
